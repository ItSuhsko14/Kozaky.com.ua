---
import facebookIcon from '../icons/facebook-f.svg?raw';
import instagramIcon from '../icons/instagram.svg?raw';
import phoneIcon from '../icons/phone.svg?raw';
import telegramIcon from '../icons/telegram-plane.svg?raw';
import tiktokIcon from '../icons/tiktok.svg?raw';
import viberIcon from '../icons/viber.svg?raw';
import youtubeIcon from '../icons/youtube.svg?raw';

const contactLinks = [
  { label: 'Instagram', href: 'https://www.instagram.com/a.lutiy', icon: instagramIcon },
  { label: 'YouTube', href: 'https://www.youtube.com/@lutykozaky', icon: youtubeIcon },
  { label: 'TikTok', href: 'https://www.tiktok.com/@a.lutiy?', icon: tiktokIcon },
  { label: 'Facebook', href: 'https://www.facebook.com/lutikozaki', icon: facebookIcon },
  { label: 'Viber', href: 'https://viber.click/380676309342', icon: viberIcon },
  { label: 'Telegram', href: 'https://t.me/ALutiy', icon: telegramIcon },
  { label: 'Подзвонити', href: 'tel:+380676309342', icon: phoneIcon },
];

function toInlineIcon(svg: string) {
  const [, , viewBoxWidth, viewBoxHeight] = svg.match(/viewBox="([^"]+)"/)![1].split(' ').map(Number);
  const widthInEm = viewBoxWidth / viewBoxHeight;
  return svg.replace('<svg ', `<svg class="contact-icon" width="${widthInEm}em" height="1em" fill="currentColor" aria-hidden="true" focusable="false" `);
}
---
<div class="contacts">
	{contactLinks.map((contact) => (
		<a href={contact.href} target={contact.href.startsWith('tel:') ? undefined : '_blank'} aria-label={contact.label}>
			<Fragment set:html={toInlineIcon(contact.icon)} />
		</a>
	))}
</div>

<style is:global>
	.contact-icon {
		display: block;
	}
</style>
