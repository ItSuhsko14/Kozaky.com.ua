---
interface Props {
  assetBase: string;
}

const { assetBase } = Astro.props;
---
<!--сірий прозорий фон галереї -->
	<div id="popap-grey" class="close"></div>
	
	<!--хрестик, який закриває перегляд фото -->
	<div id="close-div" class="close">x</div>
	
	<!--модальне вікно -->
	<div class="flex-wrapper close">
		<div class="slider-wrapper">
			<div class="slide active">
				<img src="" alt="люті козаки" id="main-img">
			</div>
		</div>

		<!-- Кнопка вліво -->
		<div id="btn-left">
			&laquo;
		</div>
		<!-- Кнопка вправо -->
		<div id="btn-right">
			&raquo;
		</div>
	</div>
	
	<!-- Підключення скрипта галереї -->
	<script is:inline type="text/javascript" src={`${assetBase}script/gallery-script.js`}></script>