---
import OrderButtons from '../components/OrderButtons.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Бої на м'яких шаблях — розвага у Дніпрі | Люті козаки" description="Гості беруть м'які тренувальні шаблі й б'ються з товаришем або з козаком. Привозимо реквізит, огороджуємо майданчик і стежимо за безпекою." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />


<div class="wrapper">
	<div class="text">
		<h1> Бої на м'яких шаблях </h1>
		<p>
			Ми пропонуємо взяти до рук м'які тренувальні шаблі і спробувати свої сили в бою з товаришем чи з нашим козаком
		</p>
		<p>
			Ми привеземо весь реквізит, огородимо майданчик для проведення змагань, будемо слідкувати за безпекою та інструктувати гостей.
		</p>
		<p>
			Вікова категорія: від 8 років.<br>
			Пропускна здатність: 30-50 людей на годину.
		</p>

		
	
		<!-- Вставка footer.php -->
		<OrderButtons heading="Замовити розвагу" />
		<RelatedPages label="Інші козацькі розваги:" paths={["/knifes/", "/spears/", "/brevno/", "/koloda/", "/cviahi/", "/rubkaovochiv/", "/luchniy/"]} />

		<Footer assetBase="/" />
		
	

</div></div></body>
</Layout>
