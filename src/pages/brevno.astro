---
import OrderButtons from '../components/OrderButtons.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Бої на бревні — розвага на свято у Дніпрі | Люті козаки" description="Традиційна забава народних гулянь. Привозимо й монтуємо весь реквізит, а гості змагаються на бревні м'якими мішками." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />


<div class="wrapper">
	<div class="text">
		<h1> Бої на бревні </h1>
		<p>
			Традиційна розвага для народних гулянь.
		</p>
		<p>
			Ми привозимо і монтуємо весь реквізит, даємо гостям до рук м'які мішки, а все інше залишається за гостями.
		</p>
		
		<p>
			Вікова категорія: від 4 років.<br>
			Пропускна здатність: 30-50 людей на годину.
		</p>

	<div class="swiper">
		<div class="swiper-wrapper">
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				brevno1
				.webp" alt="
				бої на бревні
				">	
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				brevno2
				.webp " alt="
				бої на бревні
				">
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				brevno3
				.webp" alt="
				бої на бревні
				">	
			</div>
		</div>

		<!-- navigation buttons -->
		<div class="swiper-button-prev"></div>
	  	<div class="swiper-button-next"></div>
	  	
	  	<!-- pagination -->
	  	<div class="swiper-pagination"></div>

		
	</div>
		<!-- Вставка footer.php -->
		<OrderButtons heading="Замовити розвагу" />
		<RelatedPages label="Інші козацькі розваги:" paths={["/knifes/", "/spears/", "/koloda/", "/cviahi/", "/rubkaovochiv/", "/boi-na-shablyah/", "/luchniy/"]} />

		<Footer assetBase="/" />
		
	

</div></div></body>
</Layout>
