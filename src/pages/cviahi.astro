---
import OrderButtons from '../components/OrderButtons.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Забивання цвяхів — розвага на свято у Дніпрі | Люті козаки" description="Хто заб'є цвях найменшою кількістю ударів? Привозимо стенд, молотки й цвяхи, козак слідкує за безпекою та влаштовує змагання." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />


<div class="wrapper">
	<div class="text">
		<h1> Забивання цвяхів </h1>
		<p>
			Гарна розвага, яка завжди викликає інтерес у дітей і також у деяких дорослих. Задача - забити цвях молотком найменьшою кількістю ударів.
		</p>
		<p>
			Ми привозимо стенд для забивання цвяхів, молотки та цвяхи. Козак слідкує за безпекою та влаштовує змагання.
		</p>
		<p>
			Вікова категорія: від 4 років.<br>
			Пропускна здатність: 50-70 людей на годину.
		</p>

	<div class="swiper">
		<div class="swiper-wrapper">
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				cviahi1
				.webp" alt="
				забивання цвяхів
				">	
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				cviahi2
				.webp" alt="
				забивання цвяхів
				">	
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				cviahi3
				.webp" alt="
				забивання цвяхів
				">	
			</div>		
		</div>

		<!-- navigation buttons -->
		<div class="swiper-button-prev"></div>
	  	<div class="swiper-button-next"></div>
	  	
	  	<!-- pagination -->
	  	<div class="swiper-pagination"></div>

		
	</div>
		<!-- Вставка footer.php -->
		<OrderButtons heading="Замовити розвагу" />
		<RelatedPages label="Інші козацькі розваги:" paths={["/knifes/", "/spears/", "/brevno/", "/koloda/", "/rubkaovochiv/", "/boi-na-shablyah/", "/luchniy/"]} />

		<Footer assetBase="/" />
		
	

</div></div></body>
</Layout>
