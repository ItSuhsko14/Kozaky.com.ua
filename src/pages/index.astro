---
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Козацьке шоу та розваги у Дніпрі | Люті козаки" description="Козацьке шоу, інтерактивні розваги, виїзна кухня та вогняна вистава для свят і подій у Дніпрі." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />

<div class="wrapper">
	<header>
		<img src="/img/img1.jpg" alt="люті козаки" id="img-main">
	</header>


	<div class="text">
		<h1 class="visually-hidden">Козацьке шоу та розваги у Дніпрі</h1>
		<p>
			«Люті козаки» проводять козацькі виступи й інтерактивні розваги, готують страви у виїзній кухні та показують вогняну виставу. Програми — для свят і подій у Дніпрі.
		</p>
	</div>
	
	<!-- послуги -->
	<div class="main-poslugi">
		<div>
			<a href="/kozakshow/"> 
				<img src="/img/mainpage/show.jpg" alt="виступи та інтерактиви">
			</a>
		</div>
		<div>
			<a href="/rozvagi/"> 
				<img src="/img/mainpage/rozvahy.jpg" alt="козацькі розваги">
			</a>
		</div>
		<div>
			<a href="/lutakuhnya/"> 
				<img src="/img/mainpage/kuhnya.jpg" alt="козацька кухня">
			</a>
		</div>
		<div>
			<a href="/kozakfire/"> 
				<img src="/img/mainpage/vognyane.jpg" alt="вогняна вистава">
			</a>
		</div>
	</div>


	<div class="video">
		<div class="video-container">
			<iframe width="560" height="315" src="https://www.youtube.com/embed/bKSD25ng0kg" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen=""></iframe>
		</div>
	</div>

	


</div>

	<!-- підключення скриптів Swiper -->
    <script is:inline src="/script/swiper-bundle.js"></script>	

    <!-- My scripts -->
    <script is:inline src="/script.js"></script>

		<!-- Вставка footer.php -->
		<Footer assetBase="/" />
		
	

</body>
</Layout>
