---
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
import YouTubeVideo from '../components/YouTubeVideo.astro';
---
<Layout title="Козацьке шоу та розваги у Дніпрі | Люті козаки" description="Козацьке шоу, інтерактивні розваги, виїзна кухня та вогняна вистава для свят і подій у Дніпрі." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />

<div class="wrapper">
	<header>
		<img src="/img/img1.webp" width="1200" height="500" alt="Учасники шоу «Люті козаки» в козацьких строях" id="img-main">
	</header>


	<div class="text">
		<h1 class="visually-hidden">Козацьке шоу та розваги у Дніпрі</h1>
		<p>
			«Люті козаки» проводять козацькі виступи й інтерактивні розваги, готують страви у виїзній кухні та показують вогняну виставу. Програми — для свят і подій у Дніпрі.
		</p>
	</div>
	
	<!-- послуги -->
	<div class="main-poslugi">
		<div>
			<a href="/kozakshow/"> 
				<img src="/img/mainpage/show.webp" width="1080" height="1080" alt="виступи та інтерактиви">
			</a>
		</div>
		<div>
			<a href="/rozvagi/"> 
				<img src="/img/mainpage/rozvahy.webp" width="1080" height="1080" alt="козацькі розваги">
			</a>
		</div>
		<div>
			<a href="/lutakuhnya/"> 
				<img src="/img/mainpage/kuhnya.webp" width="1080" height="1080" alt="Козацька кухня: виїзна кухня та кейтеринг">
			</a>
		</div>
		<div>
			<a href="/kozakfire/"> 
				<img src="/img/mainpage/vognyane.webp" width="1080" height="1080" alt="вогняна вистава">
			</a>
		</div>
	</div>


	<div class="video">
		<div class="video-container">
			<YouTubeVideo id="bKSD25ng0kg" />
		</div>
	</div>

	


</div>

	<!-- підключення скриптів Swiper -->
    <script is:inline src="/script/swiper-bundle.js"></script>	

    <!-- My scripts -->

		<!-- Вставка footer.php -->
		<Footer assetBase="/" />
		
	

</body>
</Layout>
