---
import OrderButtons from '../components/OrderButtons.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Метання ножів на свято у Дніпрі | Люті козаки" description="Виїзна розвага з метання ножів: привеземо й змонтуємо обладнання, козак-інструктор навчить влучати в ціль. Формат атракціону або майстер-класу." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />


<div class="wrapper">
	<div class="text">
		<h1> Метання ножів </h1>
		<p>
			Ця розвага приваблює багатьох людей різного статі та віку. Ми привеземо і змонтуємо все обладнання, а козак-інструктор навчить бажаючих кидати ніж таким чином, щоб якнайшвидче досягти влучання.
		</p>
		<p>
			Розвага проводиться у вигляді у форматі атракціона, де свої сили може спробувати кожний або у вигляді майстер-класу із більш поглибленим навчанням.
		</p>
		
		<p>
			Вікова категорія: від 8 років.<br>
			Пропускна здатність: 30-40 людей на годину.
		</p>

	<div class="swiper">
		<div class="swiper-wrapper">
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				nozhi1
				.webp" alt="
				метання ножів
				">	
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				nozhi2
				.webp " alt="
				люті ножі
				">
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				nozhi3
				.webp" alt="
				метання ножів
				">	
			</div>
		</div>

		<!-- navigation buttons -->
		<div class="swiper-button-prev"></div>
	  	<div class="swiper-button-next"></div>
	  	
	  	<!-- pagination -->
	  	<div class="swiper-pagination"></div>

		
	</div>
		<!-- Вставка footer.php -->
		<OrderButtons heading="Замовити розвагу" />
		<RelatedPages label="Інші козацькі розваги:" paths={["/spears/", "/brevno/", "/koloda/", "/cviahi/", "/rubkaovochiv/", "/boi-na-shablyah/", "/luchniy/"]} />

		<Footer assetBase="/" />
		
	

</div></div></body>
</Layout>
