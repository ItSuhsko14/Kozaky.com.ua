---
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Силова колода — козацька розвага у Дніпрі | Люті козаки" description="Розвага для тих, хто хоче випробувати силу: колода близько 12 або 25 кг, вправи й змагання між гостями від козаків і колоритні фото." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />


<div class="wrapper">
	<div class="text">
		<h1> Силова колода </h1>
		<p>
			Розвага для тих, хто хоче випробувати свою силу. Ми приготували колоритну колоду, з якою можна зробити невеличке тренування, змагання або просто колоритне фото.
		</p>
		<p>
			Колода має два вагових режима: звичайний (близьк 12кг) та збільшений (близько 25 кг). Козаки запропонують різноманітні вправи, а також влаштують змагання між присутніми.
		</p>
		<p>
			Вікова категорія: від 12 років.<br>
			Пропускна здатність: 40-60 людей на годину.
		</p>

	<div class="swiper">
		<div class="swiper-wrapper">
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				koloda1
				.webp" alt="
				розваги із колодою
				">	
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				koloda2
				.webp " alt="
				силова колода
				">
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/
				koloda3
				.webp" alt="
				люта колода
				">	
			</div>
		</div>

		<!-- navigation buttons -->
		<div class="swiper-button-prev"></div>
	  	<div class="swiper-button-next"></div>
	  	
	  	<!-- pagination -->
	  	<div class="swiper-pagination"></div>

		
	</div>
		<!-- Вставка footer.php -->
		<Footer assetBase="/" />
		
	

</div></div></body>
</Layout>
