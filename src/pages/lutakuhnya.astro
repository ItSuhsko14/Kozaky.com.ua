import Gallery from '../components/Gallery.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Виїзна козацька кухня в Дніпрі та Києві | Люті козаки" description="Виїзна козацька кухня на дровах для свят і корпоративів: куліш у казані, страви на саджі та грилі, вареники, млинці. Дніпро й Київ." assetBase="/">
<body><Menu assetBase="/" />
	
<div class="wrapper">		
	<header>

		<div>
			<h2 id="hh2">їжа на дровах</h2>
		</div>

		<div>
			<h1 id="hh1">ЛЮТА КУХНЯ</h1>
		</div>

	</header>


	
<!-- Swiper ---------------------------->
	<div class="swiper">
		<div class="swiper-wrapper">
			
			<div class="swiper-slide">
				<img src="/img/lutakuhnya/kuhnya1.webp" width="800" height="533" alt="Узвар із сухофруктів у казані">	
			</div>
