			</div>
			
			<div class="swiper-slide">
				<img src="/img/lutakuhnya/kuhnya5.webp" width="800" height="533" alt="Борщ бобовий у казані">	
			</div>
			<div class="swiper-slide">
				<img src="/img/lutakuhnya/kuhnya7.webp" width="800" height="533" alt="Кукурудза, зварена в казані">	
