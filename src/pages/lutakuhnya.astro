---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Козацька кухня на дровах у Дніпрі | Люті козаки" description="Виїзна козацька кухня на дровах для свят, фестивалів і корпоративів у Дніпрі." assetBase="/">
<body><Menu assetBase="/" />
	
<div class="wrapper">		
	<header>

		<div>
			<h2 id="hh2">їжа на дровах</h2>
		</div>

		<div>
			<h1 id="hh1">ЛЮТА КУХНЯ</h1>
		</div>

	</header>


	
<!-- Swiper ---------------------------->
	<div class="swiper">
		<div class="swiper-wrapper">
			
			<div class="swiper-slide">
				<img src="/img/lutakuhnya/kuhnya1.webp" alt="pictured">	
			</div>
			<div class="swiper-slide">
				<img src="/img/lutakuhnya/kuhnya2.webp" alt="pictured">	
			</div>
			<div class="swiper-slide">
				<img src="/img/lutakuhnya/kuhnya14.webp" alt="pictured">	
			</div>
			<div class="swiper-slide">
				<img src="/img/lutakuhnya/kuhnya4.webp" alt="pictured">	
			</div>
			
			<div class="swiper-slide">
				<img src="/img/lutakuhnya/kuhnya5.webp" alt="pictured">	
			</div>
			<div class="swiper-slide">
				<img src="/img/lutakuhnya/kuhnya7.webp" alt="pictured">	
			</div>
			<div class="swiper-slide">
				<img src="/img/lutakuhnya/kuhnya10.webp" alt="pictured">	
			</div>
		</div>			

		<!-- navigation buttons -->
		<div class="swiper-button-prev"></div>
	  	<div class="swiper-button-next"></div>
  	
	  	<!-- pagination -->
	  	<div class="swiper-pagination"></div>
	
	</div>

	<div class="text">
		<p>
			Люта кухня - козацька їжа на дровах в казанах, на грилях і саджах.
			Козаки приїдуть зі своїм обладнанням, змонтують на місці польову кухню і приготують різноманітні смачні страви.

			</p><ul><b>Наше меню:</b>
				<li>куліш грибний і овочевий;</li>
				<li>вареники і галушки;</li>
				<li>млинці;</li>
				<li>узвари і чаї;</li>
				<li>овочі садж і гриль;</li>
				<li>гриби садж і гриль;</li>
				<li>борщ і бульйон;</li>
				<li>картопля по селянські на садж і гриль;</li>
			</ul>
		<p></p>
		<input type="checkbox" id="t1" class="tt1" name="qa">
			<label for="t1">
    			...більше
  			</label>
  		<div>

		<p>
			Ми виступаємо на різних святах: державні та календарні заходи, дні міст, корпоративні та приватні заходи.
		</p>
		</div>	
	</div>

	<div class="video">
		<div class="video-container">
			<iframe width="560" height="315" src="https://www.youtube.com/embed/bKSD25ng0kg" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen=""></iframe>
		</div>
	</div>

	
	<!-- послуги -->
	<div class="text">
		
	</div>
</div>
		
	<!-- підключення скриптів Swiper -->
    <script is:inline src="/script/swiper-bundle.js"></script>	

    <!-- My scripts -->
    <script is:inline src="/script.js"></script>

	<!-- Include footer.php block -->
	<Footer assetBase="/" />



</body>
</Layout>
