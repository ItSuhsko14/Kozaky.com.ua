---
import Contacts from '../components/Contacts.astro';
import Gallery from '../components/Gallery.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Фото з виступів і свят | Люті козаки" description="Фотографії козацьких виступів, розваг і свят «Лютих козаків». Найсвіжіші фото — в Instagram @a.lutiy." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />


<div class="wrapper">
	
	
	<h1> Наші фото </h1>

	<p>
		Найбільш актуальні фото дивіться в нашому інстаграм.
	</p>
	<div class="btn-wrapper">
		<a href="https://www.instagram.com/a.lutiy" target="_blank">
			<div class="link-btn">
				Instagram.com/a.lutiy
			</div>
		</a>
	</div>

	


	<!--фото галереї -->
	<div class="gallery">
		<img src="/img/luti32.webp" width="800" height="800" alt="Вогняна вистава «Білі демони» від «Лютих козаків»" class="img-small">
		<img loading="lazy" src="/img/luti41.webp" width="1080" height="1080" alt="Козак із прапором на козацькому святі" class="img-small">
		<img loading="lazy" src="/img/luti42.webp" width="1080" height="1080" alt="Козак готує страву в казані на козацькому святі" class="img-small">
		<img loading="lazy" src="/img/luti43.webp" width="1080" height="1080" alt="Козак розливає страву з казана" class="img-small">
		<img loading="lazy" src="/img/luti44.webp" width="1080" height="1080" alt="Козаки показують бойові прийоми на сцені" class="img-small">
		<img loading="lazy" src="/img/luti45.webp" width="1080" height="1080" alt="Козак із двома шаблями на сцені" class="img-small">
		<img loading="lazy" src="/img/luti46.webp" width="1080" height="1080" alt="Гості свята беруть участь в інтерактиві з козаками" class="img-small">
		<img loading="lazy" src="/img/luti47.webp" width="1080" height="1080" alt="Козак проводить інтерактивний номер із глядачами" class="img-small">
		<img loading="lazy" src="/img/luti48.webp" width="1080" height="1080" alt="Козаки з вогняними шаблями" class="img-small">
		<img loading="lazy" src="/img/luti49.webp" width="1080" height="1080" alt="Вогняне шоу козаків на святі" class="img-small">
	</div>

	

</div>


	<!-- Вживляємо галерею -->
	<Gallery assetBase="/" />	
	
	

</body>
</Layout>
