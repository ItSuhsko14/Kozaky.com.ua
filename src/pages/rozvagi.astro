---
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Козацькі розваги у Дніпрі | Люті козаки" description="Виїзні козацькі розваги для свят, корпоративів та масових заходів у Дніпрі." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />


<div class="wrapper">
	<div class="text">
		<h1> Козацькі розваги </h1>
		
			Люті козаки роблять розваги в козацькому стилі, які створюють колоритну атмосферу та дозволяють кожному розважитись і прийняти участь в майстер-класах.
		
	</div>
	
	<div class="rozvagi-wrapper">

		
		<a href="/luchniy/">
		<div class="rozvagi-main">
			<div class="rozvaga-text">
				<div class="rozvagi-title"> 
					<h2>Лучний тир</h2>
				</div>
				Найбільш популярна активність, яка приваблює людей будь-якого віку.
			</div>
		
		
			<div class="rozvagi-photo">
					<img class="rozvagi-img" src="/img/rozvagi/Luti03.webp" alt="Хлопчик стріляє з лука в лучному тирі разом з інструктором">
			</div>
		</div>	
		</a>

		<a href="/knifes/">
		<div class="rozvagi-main">
			<div class="rozvaga-text">
				<div class="rozvagi-title"> 
					<h2>Метання ножів</h2>
				</div>
				Колоритна і безпечна розвага. Підходить для дорослих і дітей від 8 років.
			</div>
		
		
			<div class="rozvagi-photo">
					<img loading="lazy" class="rozvagi-img" src="/img/rozvagi/Luti08.webp" alt="Метання ножів у мішень">
			</div>
		</div>	
		</a>

		<a href="/spears/">
		<div class="rozvagi-main">
			<div class="rozvaga-text">
				<div class="rozvagi-title"> 
					<h2>Метання списів</h2>
				</div>
				Оригінальна активність, яку не часто зустрінеш серед інших атракціонів. 
			</div>
		
		
			<div class="rozvagi-photo">
					<img loading="lazy" class="rozvagi-img" src="/img/rozvagi/Spisi1.webp" alt="Метання списів у мішень">
			</div>
		</div>	
		</a>

		<a href="/rubkaovochiv/">
		<div class="rozvagi-main">
			<div class="rozvaga-text">
				<div class="rozvagi-title"> 
					<h2>Рубка овочів</h2>
				</div>
				Відчуй, як користуватися справжнею шаблею.
			</div>
		
		
			<div class="rozvagi-photo">
					<img loading="lazy" class="rozvagi-img" src="/img/rozvagi/Luti07.webp " alt="Дівчинка рубає овочі шаблею поруч із козаком">
			</div>
		</div>	
		</a>	

		<a href="/koloda/">
		<div class="rozvagi-main">
			<div class="rozvaga-text">
				<div class="rozvagi-title"> 
					<h2>Силова колода</h2>
				</div>
				Розваги і змагання на силу з оригінальним реквізитом.
			</div>
		
		
			<div class="rozvagi-photo">
					<img loading="lazy" class="rozvagi-img" src="/img/rozvagi/Luti01.webp" alt="Козак піднімає силову колоду">
			</div>
		</div>	
		</a>

		<a href="/boi-na-shablyah/">
		<div class="rozvagi-main">
			<div class="rozvaga-text">
				<div class="rozvagi-title"> 
					<h2>Бої на м'яких шаблях</h2>
				</div>
				Безпечно і весело.
			</div>
		
		
			<div class="rozvagi-photo">
					<img loading="lazy" class="rozvagi-img" src="/img/rozvagi/Luti06.webp" alt="Бої на м'яких шаблях">
			</div>
		</div>
		</a>	

		<a href="/brevno/">
		<div class="rozvagi-main">
			<div class="rozvaga-text">
				<div class="rozvagi-title"> 
					<h2>Бої на бревні</h2>
				</div>
				Традиційна розвага для народних гулянь.
			</div>
		
			<div class="rozvagi-photo">
					<img loading="lazy" class="rozvagi-img" src="/img/rozvagi/Brevno.webp" alt="Бої на бревні м'якими мішками">
			</div>
		</div>	
		</a>

		<a href="/cviahi/">
		<div class="rozvagi-main">
			<div class="rozvaga-text">
				<div class="rozvagi-title"> 
					<h2>Забиваня цвяхів</h2>
				</div>
				Розвага добре підходить для дітей.
			</div>
		
		
			<div class="rozvagi-photo">
					<img loading="lazy" class="rozvagi-img" src="/img/rozvagi/Luti04.webp" alt="Забивання цвяхів на козацькому святі">
			</div>
		</div>	
		</a>
	</div>

	<div class="swiper">
		<div class="swiper-wrapper">
			<div class="swiper-slide">
				<img src="/img/rozvagi/Luti01.webp" alt="козацька колода">
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/Luti03.webp" alt="лучний тир">
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/Luti04.webp" alt="забивання цвяхів">	
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/Luti06.webp" alt="бої на м'яких шаблях">
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/Luti07.webp" alt="рубка овочів шаблею">
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/Luti08.webp" alt="метання ножів">
			</div>
		</div>

		<!-- navigation buttons -->
		<div class="swiper-button-prev"></div>
	  	<div class="swiper-button-next"></div>
	  	
	  	<!-- pagination -->
	  	<div class="swiper-pagination"></div>

		
	</div>
	


		<!-- Вставка footer.php -->
		<Footer assetBase="/" />
		
	

</div></body>
</Layout>
