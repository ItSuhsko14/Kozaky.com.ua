---
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />


<div class="wrapper">
	<div class="text">
		<h1> Люті шаблі </h1>
		
			Шабля - один з основних символів козацтва. Ми щиро захоплені шаблями, їхніми формою, красою, історією, способами володіння. Саме це підштовхнуло нас до глибинного вивчення історії, різновидів, конструктивних особливостей різних шабель. Після чого ми знайшли майстрів різних профілей і почали створення власної колекції - Люті шаблі. Це виїзна виставка моделей шабель, заснованих на реальних зразках світових музеїв.
			Ця виставка на даний момент має виїзний характер і подорожує по різних закутках країни, а ми постійно шукаємо і відтворюємо нові екземпляри.
		
	</div>
	
	<div class="shably-wrapper">
		<a class="shably-container" href="/article4/">
			<div class="shably-text">
				<h2>Польсько-угорська</h2>
			</div>
			<div class="shably-photo">
				<img src="/img/shably/polsug/polsug8.jpg " alt="шабля польсько-угорського типу">
			</div>
		</a>

		<a class="shably-container" href="/article2/">
			<div class="shably-text">
				<h2>Кілідж</h2>
			</div>
			<div class="shably-photo">
				<img src="/img/shably/kilidg/kilidg1.jpg" alt="кілідж">
			</div>
		</a>

		<a class="shably-container" href="/article3/">
			<div class="shably-text">
				<h2>Шабля орла</h2>
			</div>
			<div class="shably-photo">
				<img src="/img/shably/shablyaorla/shablyaorla4.jpg" alt="шабля орла">
			</div>
		</a>
	

	
	</div>

	


		<!-- Вставка footer.php -->
		<Footer assetBase="/" />
		
	

</div></body>
</Layout>
