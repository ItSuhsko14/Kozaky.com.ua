---
import OrderButtons from '../components/OrderButtons.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Метання списів на свято у Дніпрі | Люті козаки" description="Незвичайна виїзна розвага для міських свят, корпоративів і приватних заходів. Привозимо стенд для метання списів, козак-інструктор навчить кидати." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />


<div class="wrapper">
	<div class="text">
		<h1> Метання списів </h1>
		<p>
			Метання списів - незвичайна та цікава розвага, яку не багато де можна зустріти.
		</p>
		<p>
			Розвага буде доречною на міських і державних святах, а також на корпоративних і приватних заходах.
		</p>
		<p>
			Ми привозимо і монтуємо стенд для метання списів. Наш козак-інструктор допможе кожному спробувати свої сили і навчитись кидати списи.
		</p>
		<p>
			Вікова категорія: від 10 років.<br>
			Пропускна здатність: 30-40 людей на годину.
		</p>

	<div class="swiper">
		<div class="swiper-wrapper">
			<div class="swiper-slide">
				<img src="/img/rozvagi/Spisi1.webp" alt="козацька колода">
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/Spisi2.webp" alt="лучний тир">
			</div>
			<div class="swiper-slide">
				<img src="/img/rozvagi/Spisi3.webp" alt="забивання цвяхів">	
			</div>
		</div>

		<!-- navigation buttons -->
		<div class="swiper-button-prev"></div>
	  	<div class="swiper-button-next"></div>
	  	
	  	<!-- pagination -->
	  	<div class="swiper-pagination"></div>

		
	</div>
		<!-- Вставка footer.php -->
		<OrderButtons heading="Замовити розвагу" />
		<RelatedPages label="Інші козацькі розваги:" paths={["/knifes/", "/brevno/", "/koloda/", "/cviahi/", "/rubkaovochiv/", "/boi-na-shablyah/", "/luchniy/"]} />

		<Footer assetBase="/" />
		
	

</div></div></body>
</Layout>
