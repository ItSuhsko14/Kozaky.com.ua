---
import OrderButtons from '../components/OrderButtons.astro';
import RelatedPages from '../components/RelatedPages.astro';
import Contacts from '../components/Contacts.astro';
import Gallery from '../components/Gallery.astro';
import Layout from '../layouts/Layout.astro';
import Menu from '../components/Menu.astro';
---
<Layout title="Свято в козацькому стилі у Дніпрі | Люті козаки" description="Організуємо все свято: козацькі виступи, розваги, кухню й вогняну виставу, а також сцену, апаратуру, сценарій, артистів і транспорт через підрядників." assetBase="/">
<body>

		<!-- Include menu.php block -->
		<Menu assetBase="/" />

		<!-- Include menu.php block -->
		<Contacts />


<div class="wrapper">
	<h1> Свято в козацькому стилі </h1>

	<p>
		Ми готові організувати для Вас всі розділи свята, в які можуть входити наші послуги:
		</p><ul>
			<li><a href="/kozakshow/">козацькі виступи;</a></li>
			<li><a href="/rozvagi/">розваги;</a></li>
			<li><a href="/lutakuhnya/">люта кухня;</a></li>
			<li><a href="/kozakfire/">вогняна вистава.</a></li>
		</ul>
	<p>
		А також організувати послуги підрядників, які необхідні для повноцінного свята: музична апаратура, сцена, сценарій, музичні колективи, артисти, транспорт, тощо.
	</p>
	<p></p>
	
	<!--фото галереї -->
	<div class="gallery">
		<img src="/img/luti32.webp" alt="Вогняна вистава «Білі демони» від «Лютих козаків»" class="img-small">
		<img loading="lazy" src="/img/luti41.webp" alt="Козак із прапором на козацькому святі" class="img-small">
		<img loading="lazy" src="/img/luti42.webp" alt="Козак готує страву в казані на козацькому святі" class="img-small">
		<img loading="lazy" src="/img/luti43.webp" alt="Козак розливає страву з казана" class="img-small">
		<img loading="lazy" src="/img/luti44.webp" alt="Козаки показують бойові прийоми на сцені" class="img-small">
		<img loading="lazy" src="/img/luti45.webp" alt="Козак із двома шаблями на сцені" class="img-small">
		<img loading="lazy" src="/img/luti46.webp" alt="Гості свята беруть участь в інтерактиві з козаками" class="img-small">
		<img loading="lazy" src="/img/luti47.webp" alt="Козак проводить інтерактивний номер із глядачами" class="img-small">
		<img loading="lazy" src="/img/luti48.webp" alt="Козаки з вогняними шаблями" class="img-small">
		<img loading="lazy" src="/img/luti49.webp" alt="Вогняне шоу козаків на святі" class="img-small">
	</div>

	<!-- Вживляємо галерею -->
	<Gallery assetBase="/" />	

</div>
	
	

<div class="wrapper">
	<div class="text">
		<OrderButtons heading="Замовити свято" />
		<RelatedPages label="Також може бути цікаво:" paths={["/kozakshow/", "/rozvagi/", "/lutakuhnya/", "/kozakfire/"]} />
	</div>
</div>

</body>
</Layout>
